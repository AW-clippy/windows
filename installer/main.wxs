<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  
  <Package Name="AWClippy"
           Manufacturer="AW Clippy Team"
           Version="$(var.Version)"
           UpgradeCode="C451878E-D135-4B82-9694-82D5C397072E"
           Scope="perMachine">
    
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  Schedule="afterInstallInitialize"
                  AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="..\icons\app_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/AW-clippy" />

    <!-- Terminate any running instance before install/upgrade/uninstall -->
    <util:CloseApplication Id="CloseAWClippy"
                           Target="awclippy-windows.exe"
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           RebootPrompt="no"
                           TerminateProcess="1" />

    <!-- Forceful fallback: taskkill executed before Windows Installer checks if files are in use -->
    <CustomAction Id="KillAWClippy"
                  Directory="TARGETDIR"
                  ExeCommand="&quot;[System64Folder]taskkill.exe&quot; /F /IM awclippy-windows.exe /T"
                  Execute="immediate"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="KillAWClippy" Before="InstallValidate" />
    </InstallExecuteSequence>

    <InstallUISequence>
      <Custom Action="KillAWClippy" Before="ExecuteAction" />
    </InstallUISequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AWClippy">
        <Component Id="MainExecutable" Guid="3F875152-A62E-4D56-8A39-FA459CD99120" Bitness="always64">
          <File Id="awclippy_windows_exe"
                Source="..\target\release\awclippy-windows.exe"
                KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AWClippy">
        <Component Id="ApplicationShortcuts" Guid="736DF96E-5C13-4B94-8833-28D8A7499D54">
          <!-- Launch shortcut -->
          <Shortcut Id="ApplicationStartMenuShortcut"
                    Name="AWClippy"
                    Description="AWClippy Universal Clipboard Sync"
                    Target="[!awclippy_windows_exe]"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon.ico" />

          <!-- Uninstall shortcut in Start Menu -->
          <Shortcut Id="UninstallProductShortcut"
                    Name="Uninstall AWClippy"
                    Description="Uninstalls AWClippy from this PC"
                    Target="[System64Folder]msiexec.exe"
                    Arguments="/x [ProductCode]"
                    Icon="AppIcon.ico" />

          <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\AWClippy" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Auto-start with Windows via Registry -->
    <StandardDirectory Id="TARGETDIR">
      <Component Id="AutoStartComponent" Guid="A9203C11-C581-4C10-9140-54D81E9A680C">
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="AWClippy"
                       Type="string"
                       Value="&quot;[#awclippy_windows_exe]&quot;"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="AWClippy" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ApplicationShortcuts" />
      <ComponentRef Id="AutoStartComponent" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
  </Package>
</Wix>
