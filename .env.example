# AWClippy Windows Configuration
# Copy this file to .env and customize

# Shared encryption key (MUST be exactly 32 bytes/characters)
AWCLIPPY_SHARED_SECRET=CHANGE_THIS_TO_YOUR_SECRET_KEY!!

# Network ports
AWCLIPPY_DISCOVERY_PORT=48899
AWCLIPPY_SYNC_PORT=48900

# Optional: Android device IP (for direct connection without discovery)
AWCLIPPY_ANDROID_IP=

# Logging level: error, warn, info, debug, trace
RUST_LOG=info
